# gelistirme modu
VERITABANI_ADRESI=sqlite:///kurt.db

# merkezi mod icin gercek PostgreSQL adresini kullan
# VERITABANI_ADRESI=postgresql+psycopg://kullanici:sifre@sunucu:5432/kurt

GIZLI_ANAHTAR=kendi-gizli-anahtarini-yaz
HOST=127.0.0.1
PORT=5000
GUNLUK_SEVIYESI=INFO

# kendi API anahtarini yerel .env dosyasina yaz
AI_ANAHTARI=
# alternatif: OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
